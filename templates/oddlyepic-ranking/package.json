{
  "name": "oddlyepic-ranking",
  "version": "1.0.0",
  "description": "OddlyEpic RankReel — reusable 9:16 ranking Short format with the OddlyEpic Meter",
  "scripts": {
    "prepare-clips": "python3 prepare.py",
    "prepare-draft": "python3 prepare.py --draft",
    "check": "python3 prepare.py --check",
    "studio": "remotion studio",
    "render": "python3 prepare.py --check && remotion render RankReel out/rankreel.mp4",
    "render:draft": "remotion render RankReel out/rankreel-DRAFT.mp4",
    "render:preview": "remotion render RankReel out/preview.mp4 --scale=0.5",
    "still": "remotion still RankReel out/frame.png --frame=60"
  },
  "dependencies": {
    "@remotion/cli": "4.0.529",
    "@remotion/google-fonts": "4.0.529",
    "@remotion/transitions": "4.0.529",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "remotion": "4.0.529"
  },
  "devDependencies": {
    "@types/react": "^18.2.0",
    "typescript": "^5.0.0"
  }
}
